{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(wc:*)"
    ],
    "deny": []
  }
}
