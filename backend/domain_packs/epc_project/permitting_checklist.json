{
  "pack": "epc_project",
  "version": "1.0.0",
  "total_permits": 28,
  "permits": [
    {
      "permit_name": "Environmental Clearance (EC)",
      "why_needed": "Statutory requirement under EIA Notification for any industrial project exceeding specified thresholds",
      "responsible_role": "Regulatory Affairs / DCEO",
      "required_inputs": [
        "EIA report",
        "site selection report",
        "water consumption assessment",
        "waste management plan"
      ],
      "phase": 1,
      "dependencies": [
        "EIA baseline study completed",
        "site finalised"
      ],
      "estimated_lead_time_months": 12,
      "evidence_required": "Environmental clearance letter from MoEFCC / SEIAA"
    },
    {
      "permit_name": "Consent to Establish (CTE)",
      "why_needed": "Approval from Pollution Control Board before starting construction",
      "responsible_role": "Regulatory Affairs",
      "required_inputs": [
        "EC letter",
        "site plan",
        "process description",
        "water & air pollution control plan",
        "green belt plan"
      ],
      "phase": 2,
      "dependencies": [
        "EC received"
      ],
      "estimated_lead_time_months": 3,
      "evidence_required": "CTE certificate"
    },
    {
