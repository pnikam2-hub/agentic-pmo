# Agentic PMO — Environment Configuration
# Copy this file to .env and fill in your values before running.

# ── LLM / AI Agent Configuration ──────────────────────────────────────────
# Provider: openai, anthropic, openrouter
LLM_PROVIDER=openai

# API key from your LLM provider (required for AI agent capabilities)
# Get one at: https://platform.openai.com/api-keys
LLM_API_KEY=your-api-key-here

# Model name (provider-dependent):
#   OpenAI: gpt-4o, gpt-4o-mini
#   Anthropic: claude-sonnet-4-20250514
#   OpenRouter: openai/gpt-4o, anthropic/claude-sonnet-4
LLM_MODEL=gpt-4o

# Custom base URL (e.g. for OpenRouter or a local LLM)
# LLM_BASE_URL=https://openrouter.ai/api/v1

# ── Database ──────────────────────────────────────────────────────────────
# Default: SQLite stored in the app directory
# DATABASE_URL=sqlite:///./agentic_pmo.db
# For Docker with volume: DATABASE_URL=sqlite:///./data/agentic_pmo.db

# ── Authentication — CHANGE THESE BEFORE DEPLOYING ────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here

# ── Alert Channels: Email ───────────────────────────────────────────────
# Configure if you want email alerts from the Alert Agent
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you...n
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you...n
# ALERT_EMAIL_TO=you...n

# ── Alert Channels: Webhook ─────────────────────────────────────────────
# Configure if you want webhook alerts (Slack, Teams, etc.)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/xxx

# ── Scheduled Monitor ────────────────────────────────────────────────────
# Set to > 0 to enable automatic periodic health checks
# MONITOR_INTERVAL_MINUTES=60
