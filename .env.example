# Agentic PMO — Environment Configuration
# Copy this to .env and fill in your values

# LLM Provider for AI Agents
# Options: openai, anthropic, openrouter
LLM_PROVIDER=openai

# API Key for your LLM provider
# Get one at: https://platform.openai.com/api-keys
LLM_API_KEY=sk-your-api-key-here

# Model name (provider-dependent)
# OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo
# Anthropic: claude-sonnet-4-20250514, claude-3-5-sonnet-20241022
# OpenRouter: openai/gpt-4o, anthropic/claude-sonnet-4, etc.
LLM_MODEL=gpt-4o

# Optional: Custom base URL (for OpenRouter, local LLMs, etc.)
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Database URL (default: local SQLite file)
# DATABASE_URL=sqlite:///./agentic_pmo.db

# Server configuration
# HOST=0.0.0.0
# PORT=8000
